{
  "name": "plc-pilot",
  "version": "0.1.7",
  "private": true,
  "description": "面向 CODESYS 3.5.22 的 Codex 风格 PLC 桌面工作台",
  "type": "module",
  "workspaces": ["stone-mcp"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:agent-host": "node scripts/build-agent-host.mjs",
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "build:stone-mcp": "node scripts/build-stone-mcp.mjs",
    "test:stone-mcp": "node --test stone-mcp/test/*.test.mjs",
    "test:diagnostics": "node --test shared/diagnostics.test.mjs",
    "package:stone-mcp": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-stone-mcp.ps1",
    "build": "npm run build:agent-host && npm run build:stone-mcp && npm run prepare-runtime && vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build && npm run package:portable",
    "package:portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@tabler/icons-vue": "^3.46.0",
    "@tauri-apps/api": "^2.8.0",
    "highlight.js": "^11.11.1",
    "pino": "10.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vue-tsc": "^2.2.0"
  }
}

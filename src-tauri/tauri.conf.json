{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLC Pilot",
  "version": "0.1.7",
  "identifier": "com.plcpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PLC Pilot",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../agent-host/pi-agent-host.bundle.mjs": "pi-agent-host.bundle.mjs",
      "../runtime-stage/node": "runtime/node",
      "../runtime-stage/python": "runtime/python",
      "../runtime-stage/runtime-manifest.json": "runtime/runtime-manifest.json",
      "../stone-mcp/dist/stone-mcp-server.mjs": "stone-mcp/stone-mcp-server.mjs",
      "../stone-mcp/dist/bridge.py": "stone-mcp/bridge.py",
      "../stone-mcp/dist/data/official-api.json.gz": "stone-mcp/data/official-api.json.gz",
      "../stone-mcp/dist/MCP-SDK-LICENSE": "stone-mcp/MCP-SDK-LICENSE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQTMyMDkwODU5NzdDRjEKUldUeGZKZUZrQ0NqTzZEeDZZYlFURVJnWERSUzlzOHlLYlFLMi8zZ1A5bVVwTThJeTNmYWZIQ3kK",
      "endpoints": ["https://github.com/1812095643/PLCpilot/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
